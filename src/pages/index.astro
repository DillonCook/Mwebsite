---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import ReviewCard from "../components/ReviewCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import {
  business,
  createBreadcrumbSchema,
  createFaqSchema,
  createWebPageSchema,
  faqGroups,
  reviewHighlights,
  serviceCards,
  toHref,
  valuePoints,
} from "../data/site";

const title = "Wesley Chapel AC Repair | Wesley Chapel A/C Company";
const description =
  "Residential AC repair, maintenance, and replacement for Wesley Chapel homeowners. Family-owned, licensed, and local.";

const homepageFaqs = [
  faqGroups.repair[0],
  faqGroups.repair[3],
  faqGroups.maintenance[0],
  faqGroups.replacement[1],
];

const schema = [
  createWebPageSchema({
    pathname: "/",
    title,
    description,
  }),
  createBreadcrumbSchema([{ name: "Home", pathname: "/" }]),
  createFaqSchema(homepageFaqs),
];
---

<BaseLayout title={title} description={description} pathname="/" schema={schema}>
  <PageHero
    eyebrow="Family-owned AC service in Wesley Chapel, Florida"
    title="Residential A/C Service in Wesley Chapel"
    summary="Wesley Chapel A/C Company provides repair, maintenance, and replacement for homeowners in Wesley Chapel. This site is meant to give a clear overview of services, service area, and contact information."
    imageSrc="/images/mike-checking-system.jpg"
    imageAlt="Mike checking an HVAC system"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/contact/", label: "Contact Info" }}
    highlights={[
      "Residential service only",
      "Wesley Chapel homeowners only",
      "Licensed Florida contractor",
    ]}
  />

  <section class="trust-strip">
    <div class="container">
      <ul class="trust-strip__list">
        <li>Family-owned</li>
        <li>Serving Wesley Chapel only</li>
        <li>Licensed {business.license}</li>
        <li>Phone-first contact</li>
      </ul>
    </div>
  </section>

  <section class="section section--spacious">
    <div class="container">
      <SectionHeading
        eyebrow="Straight answers first"
        title="Service information for Wesley Chapel homeowners"
        intro="They want someone to show up, figure out what is actually wrong, explain it clearly, and make the most practical recommendation. That is the standard Wesley Chapel A/C Company tries to keep on every call."
      />

      <div class="cards-grid">
        {serviceCards.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="What the site covers"
          title="A straightforward local listing"
          intro="The basics stay simple: who the company is, what services are offered, and how to get in touch."
        />

        <ul class="text-list">
          {valuePoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>

      <aside class="stat-card">
        <h3>Services</h3>
        <strong>Repair, maintenance, replacement.</strong>
        <p>
          Residential service in Wesley Chapel with clear recommendations and
          phone-first contact.
        </p>
        <ul class="pill-list">
          <li>Residential service</li>
          <li>Phone-first contact</li>
          <li>Licensed</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="media-card">
        <img
          src={toHref("/images/mike-portrait.jpg")}
          alt="Mike Reaka standing beside the company van"
          loading="lazy"
        />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="A local company with Wesley Chapel roots"
          title="Local roots and practical service"
          intro="Mike Reaka and his family have deep roots in Wesley Chapel. The company was built around a simple idea: explain the problem plainly, fix what can be fixed, and treat customers the way neighbors should be treated."
        />

        <div class="utility-links">
          <a class="button button-secondary" href={toHref("/about-us/")}>More About Us</a>
          <a class="button button-primary" href={business.phoneHref}>Call {business.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Customer comments"
        title="What local homeowners say after the work is done"
        intro="These are the kinds of comments that matter when your house is hot and you need someone responsive, practical, and straightforward."
      />

      <div class="review-grid">
        {reviewHighlights.map((review) => (
          <ReviewCard {...review} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Common questions"
          title="Quick answers for Wesley Chapel homeowners"
        intro="A few common questions come up on almost every call. Here are the short answers."
        />
        <FaqList items={homepageFaqs} />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="Where to next"
          title="Choose the page that matches the problem"
          intro="If you already know what you need, go straight to the page that fits your situation."
        />
        <ul class="text-list">
          <li>
            <a href={toHref("/repair/")}>See the repair page if the AC is not cooling.</a>
          </li>
          <li>
            <a href={toHref("/maintenance/")}>See the maintenance page for practical upkeep guidance.</a>
          </li>
          <li>
            <a href={toHref("/ac-replacement/")}>See the replacement page if a bigger decision may be coming.</a>
          </li>
          <li>
            <a href={toHref("/reviews/")}>Read reviews from local homeowners.</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CallToAction
    title="For service or scheduling, call Wesley Chapel A/C Company."
    body="Phone is the main contact method for repair, maintenance, and replacement work in Wesley Chapel."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
