---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import PageHero from "../components/PageHero.astro";
import ReviewCard from "../components/ReviewCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  business,
  createBreadcrumbSchema,
  createWebPageSchema,
  reviewHighlights,
  toHref,
} from "../data/site";

const title = "About Mike | Wesley Chapel A/C Company";
const description =
  "I am Mike Reaka, and I run Wesley Chapel A/C Company for local homeowners who want clear advice and practical service.";

const schema = [
  createWebPageSchema({
    pathname: "/about-us/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "About", pathname: "/about-us/" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/about-us/"
  image="/images/mike-portrait.jpg"
  schema={schema}
>
  <PageHero
    eyebrow="Local and family-owned"
    title="About Wesley Chapel A/C Company"
    summary="I run Wesley Chapel A/C Company as a family-owned residential A/C company serving homeowners in Wesley Chapel. On this page, I explain a little about myself and how I approach the work."
    imageSrc="/images/mike-portrait.jpg"
    imageAlt="Mike Reaka standing beside a service van"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/reviews/", label: "Read Reviews" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/about-us/", label: "About" },
    ]}
    highlights={[
      "Wesley Chapel roots",
      "Family-owned",
      `Licensed Florida contractor ${business.license}`,
    ]}
  />

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Meet Mike Reaka"
          title="Why I keep this local"
          intro="My family and I have longstanding roots in Wesley Chapel. I built this company around the idea that local homeowners deserve clear advice, careful work, and someone who keeps things practical when the heat is not giving anybody much patience."
        />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="What I believe"
          title="How I approach the work"
        />
        <ul class="text-list">
          <li>I try to be clear about the problem.</li>
          <li>I fix what can be fixed.</li>
          <li>I recommend replacement only when it is practical.</li>
          <li>I treat people like neighbors, not transactions.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-up">
      <article class="surface-card">
        <SectionHeading
          eyebrow="Grounded values"
          title="Faith-informed, but still plainspoken"
          intro="My approach is shaped by convictions about stewardship and accountability. That shows up less in slogans and more in how I make recommendations and how I treat people."
        />
        <p class="verse-note">
          <span>"The Borrower Becomes The Slave To The Lender."</span>
          <strong>Proverbs 22:7</strong>
        </p>
      </article>

      <article class="surface-card">
        <SectionHeading
          eyebrow="Licensed and visible"
          title="Licensing should be easy to find"
          intro="I am a licensed Florida contractor. Homeowners deserve to know who they are inviting to work on their system."
        />
        <ul class="pill-list">
          <li>License {business.license}</li>
          <li>Serving Wesley Chapel</li>
          <li>Family-owned</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <figure class="media-figure">
        <div class="media-card">
          <img
            src={toHref("/images/mike-go-kart.jpg")}
            alt="An older candid photo of Mike riding a go-kart"
            loading="lazy"
          />
        </div>
        <figcaption class="media-caption">
          An older candid photo I have kept as part of my story.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Customer comments"
        title="What local homeowners say after the work is done"
      />

      <div class="review-grid">
        {reviewHighlights.map((review) => (
          <ReviewCard {...review} />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title="If you need service or scheduling, call me."
    body="I serve Wesley Chapel homeowners and keep phone as the main contact method."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
