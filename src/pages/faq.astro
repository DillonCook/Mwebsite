---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  business,
  createBreadcrumbSchema,
  createFaqSchema,
  createWebPageSchema,
  faqGroups,
} from "../data/site";

const title = "Wesley Chapel A/C Company FAQ | Repair, Maintenance, Replacement";
const description =
  "Straight answers to common questions I hear about repairs, filters, tune-ups, replacement decisions, and what to expect.";

const allFaqs = [
  ...faqGroups.general,
  ...faqGroups.repair,
  ...faqGroups.maintenance,
  ...faqGroups.replacement,
];

const schema = [
  createWebPageSchema({
    pathname: "/faq/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "FAQ", pathname: "/faq/" },
  ]),
  createFaqSchema(allFaqs),
];
---

<BaseLayout title={title} description={description} pathname="/faq/" schema={schema}>
  <PageHero
    eyebrow="Straight answers"
    title="Wesley Chapel A/C Company FAQ"
    summary="These are straightforward answers to common questions I hear from Wesley Chapel homeowners. If you need help with a specific problem, the fastest next step is to call me."
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/contact/", label: "Contact Info" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/faq/", label: "FAQ" },
    ]}
    highlights={[
      "Questions about where I work",
      "Repair and maintenance guidance",
      "Plain repair-vs-replace answers",
    ]}
  />

  <section class="section">
    <div class="container two-up">
      <article class="surface-card">
        <SectionHeading eyebrow="General" title="Questions I get about service area and availability" />
        <FaqList items={faqGroups.general} />
      </article>

      <article class="surface-card">
        <SectionHeading eyebrow="Repair" title="Questions people ask me when the AC is down" />
        <FaqList items={faqGroups.repair} />
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container two-up">
      <article class="surface-card">
        <SectionHeading eyebrow="Maintenance" title="Questions I hear about upkeep" />
        <FaqList items={faqGroups.maintenance} />
      </article>

      <article class="surface-card">
        <SectionHeading eyebrow="Replacement" title="Questions I hear about bigger decisions" />
        <FaqList items={faqGroups.replacement} />
      </article>
    </div>
  </section>

  <CallToAction
    title="If you still have a question, call me."
    body="Call me if you want a direct answer about your system and what makes sense next."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
