---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import ReviewCard from "../components/ReviewCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import {
  business,
  createBreadcrumbSchema,
  createFaqSchema,
  createWebPageSchema,
  faqGroups,
  reviewHighlights,
  serviceCards,
  toHref,
  valuePoints,
} from "../data/site";

const title = "Wesley Chapel AC Repair | Wesley Chapel A/C Company";
const description =
  "I provide residential AC repair, maintenance, and replacement for Wesley Chapel homeowners. Family-owned, licensed, and local.";

const homepageFaqs = [
  faqGroups.repair[0],
  faqGroups.repair[3],
  faqGroups.maintenance[0],
  faqGroups.replacement[1],
];

const schema = [
  createWebPageSchema({
    pathname: "/",
    title,
    description,
  }),
  createBreadcrumbSchema([{ name: "Home", pathname: "/" }]),
  createFaqSchema(homepageFaqs),
];
---

<BaseLayout title={title} description={description} pathname="/" schema={schema}>
  <PageHero
    eyebrow="Family-owned AC service in Wesley Chapel, Florida"
    title="Residential A/C Service in Wesley Chapel"
    summary="I provide repair, maintenance, and replacement for homeowners in Wesley Chapel. I built this site to give you a clear overview of what I do, where I work, and how to reach me."
    imageSrc="/images/hero-image.jpeg"
    imageAlt="Mike Reaka standing outdoors beside a service trailer"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/contact/", label: "Contact Info" }}
    highlights={[
      "I serve homeowners only",
      "I work in Wesley Chapel only",
      "Licensed Florida contractor",
    ]}
  />

  <section class="trust-strip">
    <div class="container">
      <ul class="trust-strip__list">
        <li>Family-owned</li>
        <li>Serving Wesley Chapel only</li>
        <li>Licensed {business.license}</li>
        <li>Phone-first contact</li>
      </ul>
    </div>
  </section>

  <section class="section section--spacious">
    <div class="container">
      <SectionHeading
        eyebrow="Straight answers first"
        title="Service information for Wesley Chapel homeowners"
        intro="Most people want someone to show up, figure out what is actually wrong, explain it clearly, and make a practical recommendation. That is what I try to do on every call."
      />

      <div class="cards-grid">
        {serviceCards.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="What I cover here"
          title="What I Do"
          intro="I keep this simple: what I work on, how I approach it, and how to get in touch."
        />

        <ul class="text-list">
          {valuePoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </div>

      <aside class="stat-card">
        <h3>Services</h3>
        <strong>Repair, maintenance, replacement.</strong>
        <p>
          I provide residential service in Wesley Chapel with clear
          recommendations and phone-first contact.
        </p>
        <ul class="pill-list">
          <li>Residential service</li>
          <li>Phone-first contact</li>
          <li>Licensed</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="media-card">
        <img
          src={toHref("/images/mike-home-selfie.jpg")}
          alt="Mike Reaka standing outdoors beside a service trailer"
          loading="lazy"
        />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="My roots in Wesley Chapel"
          title="Local roots and practical service"
          intro="My family and I have deep roots in Wesley Chapel. I built this company around a simple idea: explain the problem plainly, fix what can be fixed, and treat people the way neighbors should be treated."
        />

        <div class="utility-links">
          <a class="button button-secondary" href={toHref("/about-us/")}>More About Me</a>
          <a class="button button-primary" href={business.phoneHref}>Call {business.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Customer comments"
        title="What local homeowners say after the work is done"
        intro="These comments give you a sense of the kind of service I try to provide when your house is hot and you need help."
      />

      <div class="review-grid">
        {reviewHighlights.map((review) => (
          <ReviewCard {...review} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Common questions"
          title="Quick answers for Wesley Chapel homeowners"
        intro="These are a few of the questions I hear on a regular basis."
        />
        <FaqList items={homepageFaqs} />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="Where to next"
          title="Choose the page that matches the problem"
          intro="If you already know what you need, these pages go into more detail."
        />
        <ul class="text-list">
          <li>
            <a href={toHref("/repair/")}>See the repair page if the AC is not cooling.</a>
          </li>
          <li>
            <a href={toHref("/maintenance/")}>See the maintenance page for practical upkeep guidance.</a>
          </li>
          <li>
            <a href={toHref("/ac-replacement/")}>See the replacement page if a bigger decision may be coming.</a>
          </li>
          <li>
            <a href={toHref("/reviews/")}>Read reviews from local homeowners.</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <CallToAction
    title="If you need service or scheduling, call me."
    body="Phone is the main way to reach me for repair, maintenance, and replacement work in Wesley Chapel."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
