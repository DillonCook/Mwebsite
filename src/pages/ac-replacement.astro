---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import {
  business,
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
  createWebPageSchema,
  faqGroups,
  replacementFactors,
  replacementPriorities,
  serviceCards,
} from "../data/site";

const title = "AC Replacement in Wesley Chapel, FL | Wesley Chapel A/C Company";
const description =
  "When repair no longer makes sense, I provide practical AC replacement advice and clean installation for Wesley Chapel homes.";
const replacementFaqs = faqGroups.replacement;

const schema = [
  createWebPageSchema({
    pathname: "/ac-replacement/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "AC Replacement", pathname: "/ac-replacement/" },
  ]),
  createServiceSchema({
    pathname: "/ac-replacement/",
    name: "AC Replacement",
    description,
  }),
  createFaqSchema(replacementFaqs),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/ac-replacement/"
  image="/images/mike-ac-replacement.jpg"
  schema={schema}
>
  <PageHero
    eyebrow="Practical replacement guidance"
    title="AC Replacement in Wesley Chapel, FL"
    summary="Most homeowners do not want to replace an AC system before they have to. I approach replacement from that reality. If repair is still practical, I will say so. If replacement truly makes more sense, I will lay out a clean, sensible plan without inflated urgency."
    imageSrc="/images/mike-ac-replacement.jpg"
    imageAlt="Mike working on an air conditioning replacement"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/contact/", label: "Contact Info" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/ac-replacement/", label: "AC Replacement" },
    ]}
    highlights={[
      "I explain repair vs replace plainly",
      "No scripted replacement pressure",
      "I focus on installation quality",
    ]}
  />

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="When replacement makes sense"
          title="Sometimes the practical answer really is a new system"
          intro="When the repair required for continued operation is too expensive to justify, I may tell you replacement is the better long-term decision."
        />

        <ul class="text-list">
          {replacementFactors.map((factor) => (
            <li>{factor}</li>
          ))}
        </ul>
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="What matters most"
          title="A replacement project should stay grounded"
          intro="My goal is not to sell the flashiest system. My goal is to help you end up with a practical, reliable setup."
        />

        <ul class="text-list">
          {replacementPriorities.map((priority) => (
            <li>{priority}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Repair vs replace"
          title="This should be a plainspoken conversation"
          intro="I do not think this decision should be made through fear, scripting, or sales pressure. I think it should be made by looking clearly at the system, the repair required, and what makes sense for your home."
        />
      </div>

      <div class="stat-card">
        <h3>Why I do not push new systems</h3>
        <strong>Practical first.</strong>
        <p>
          I do not treat every service call like a sales opportunity. My goal
          is to help you make a wise decision when replacement is truly needed.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading eyebrow="Replacement FAQ" title="Direct answers for a bigger decision" />
        <FaqList items={replacementFaqs} />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="Related pages"
          title="If you are still weighing the options"
          intro="These pages explain how I handle repair calls and routine upkeep if you are still working through the decision."
        />
        <div class="cards-grid">
          {serviceCards
            .filter((service) => service.href !== "/ac-replacement/")
            .map((service) => <ServiceCard {...service} />)}
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="If you want a practical second opinion on repair versus replacement, call me."
    body="I can explain the decision clearly before you commit to a major expense."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
