---
import { toHref } from "../data/site";

interface Props {
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  body,
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <p class="eyebrow">Schedule service</p>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-band__actions">
      <a class="button button-primary" href={toHref(primaryHref)}>{primaryLabel}</a>
      {secondaryHref && secondaryLabel && (
        <a class="button button-secondary" href={toHref(secondaryHref)}>{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>
