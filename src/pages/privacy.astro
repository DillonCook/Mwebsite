---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import {
  createBreadcrumbSchema,
  createWebPageSchema,
} from "../data/site";

const title = "Privacy | Wesley Chapel A/C Company";
const description =
  "Privacy information for the Wesley Chapel A/C Company website.";

const schema = [
  createWebPageSchema({
    pathname: "/privacy/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "Privacy", pathname: "/privacy/" },
  ]),
];
---

<BaseLayout title={title} description={description} pathname="/privacy/" schema={schema}>
  <PageHero
    eyebrow="Utility page"
    title="Privacy"
    summary="This page explains the limited information involved in using this listing website."
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/privacy/", label: "Privacy" },
    ]}
  />

  <section class="section">
    <div class="container">
      <article class="privacy-card">
        <p>
          This website is informational and mainly provides phone, hours, and
          service-area details for Wesley Chapel A/C Company.
        </p>
        <p>
          If you choose to contact the company directly by phone and share
          service details, that information is used only to communicate about
          service. This site also does not publish a public street address.
        </p>
        <p>
          Basic hosting logs or minimal analytics may still collect routine
          technical information needed to operate the site.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
