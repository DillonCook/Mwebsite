---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import {
  createBreadcrumbSchema,
  createWebPageSchema,
} from "../data/site";

const title = "Privacy | Wesley Chapel A/C Company";
const description =
  "Privacy information for my website.";

const schema = [
  createWebPageSchema({
    pathname: "/privacy/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "Privacy", pathname: "/privacy/" },
  ]),
];
---

<BaseLayout title={title} description={description} pathname="/privacy/" schema={schema}>
  <PageHero
    eyebrow="Utility page"
    title="Privacy"
    summary="This page explains the limited information involved when you use my listing website."
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/privacy/", label: "Privacy" },
    ]}
  />

  <section class="section">
    <div class="container">
      <article class="privacy-card">
        <p>
          I use this website mainly to provide my phone number, hours, and
          service-area details for homeowners in Wesley Chapel.
        </p>
        <p>
          If you choose to contact me directly by phone and share service
          details, I use that information only to communicate about service.
          I also do not publish a public street address on this site.
        </p>
        <p>
          Basic hosting logs or minimal analytics may still collect routine
          technical information needed to operate the site.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
