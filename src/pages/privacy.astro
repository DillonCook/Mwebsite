---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import {
  createBreadcrumbSchema,
  createWebPageSchema,
} from "../data/site";

const title = "Privacy | Wesley Chapel A/C Company";
const description =
  "Privacy information for the Wesley Chapel A/C Company website.";

const schema = [
  createWebPageSchema({
    pathname: "/privacy/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "Privacy", pathname: "/privacy/" },
  ]),
];
---

<BaseLayout title={title} description={description} pathname="/privacy/" schema={schema}>
  <PageHero
    eyebrow="Utility page"
    title="Privacy"
    summary="This page explains what information may be collected when you contact Wesley Chapel A/C Company through the website."
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/privacy/", label: "Privacy" },
    ]}
  />

  <section class="section">
    <div class="container">
      <article class="privacy-card">
        <p>
          If you contact Wesley Chapel A/C Company through this website, the
          information you provide is used to respond to your request and
          communicate about service. That may include details such as your name,
          phone number, email address, and the message you submit.
        </p>
        <p>
          Contact information provided through the site is not intended for public
          display. This website also does not publish a public street address.
        </p>
        <p>
          If a third-party form service or basic website analytics are used, they
          should be limited to what is necessary to operate the website and respond
          to inquiries.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
