---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  business,
  createBreadcrumbSchema,
  createWebPageSchema,
} from "../data/site";

const title = "Contact Mike | Wesley Chapel A/C Company";
const description =
  "My phone, hours, and service details for homeowners in Wesley Chapel, FL.";

const schema = [
  createWebPageSchema({
    pathname: "/contact/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "Contact", pathname: "/contact/" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/contact/"
  image="/images/service-van.jpg"
  schema={schema}
>
  <PageHero
    eyebrow="Listing details"
    title="Contact Mike"
    summary="I keep this website simple. If you need service, scheduling, or emergency help, call me at the number below."
    imageSrc="/images/service-van.jpg"
    imageAlt="Company service van"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/contact/", label: "Contact" },
    ]}
    highlights={[
      "Call me directly",
      "I do not use online request forms",
      "I do not list a public storefront address",
      "I serve Wesley Chapel homeowners only",
    ]}
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-panel">
        <SectionHeading
          eyebrow="Call for service"
          title="Phone is the fastest way to reach me"
          intro="Urgent AC problems are best handled by phone. It is the clearest and quickest way to reach me."
        />

        <ul class="contact-stack">
          <li>
            <strong>Phone</strong>
            <a href={business.phoneHref}>{business.phone}</a>
          </li>
          <li>
            <strong>Hours</strong>
            <ul class="hours-list">
              {business.hours.map((entry) => (
                <li>
                  <span>{entry.label}</span>
                  <span>{entry.hours}</span>
                </li>
              ))}
            </ul>
          </li>
          <li>
            <strong>License</strong>
            <span>Florida contractor {business.license}</span>
          </li>
          <li>
            <strong>Service area</strong>
            <span>{business.serviceArea} homeowners only</span>
          </li>
        </ul>

        <div class="notice notice--accent">
          <strong>{business.emergencyHeadline}</strong>
          <span>{business.emergencySubnote}</span>
        </div>
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="Before you call"
          title="A little detail helps the call go faster"
          intro="This page covers the basics. If you call with a few details ready, I can explain the next step faster."
        />

        <ul class="text-list">
          <li>What the system is doing, or not doing</li>
          <li>When the problem started</li>
          <li>Whether the system is frozen, leaking, or making unusual noise</li>
          <li>The best phone number to reach you back</li>
        </ul>

        <div class="notice">
          I do not use an online service request form on this site. Phone is the contact method.
        </div>

        <div class="utility-links">
          <a class="button button-primary" href={business.phoneHref}>Call Now</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
