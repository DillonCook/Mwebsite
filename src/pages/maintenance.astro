---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import FaqList from "../components/FaqList.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import {
  business,
  createBreadcrumbSchema,
  createFaqSchema,
  createServiceSchema,
  createWebPageSchema,
  faqGroups,
  maintenanceChecklist,
  serviceCards,
} from "../data/site";

const title = "AC Maintenance in Wesley Chapel, FL | Wesley Chapel A/C Company";
const description =
  "I provide thoughtful AC maintenance for Wesley Chapel homeowners without gimmicky contracts or sales-heavy tune-up offers.";
const maintenanceFaqs = faqGroups.maintenance;

const schema = [
  createWebPageSchema({
    pathname: "/maintenance/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "AC Maintenance", pathname: "/maintenance/" },
  ]),
  createServiceSchema({
    pathname: "/maintenance/",
    name: "AC Maintenance",
    description,
  }),
  createFaqSchema(maintenanceFaqs),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/maintenance/"
  image="/images/service-van.jpg"
  schema={schema}
>
  <PageHero
    eyebrow="Practical upkeep"
    title="AC Maintenance in Wesley Chapel, FL"
    summary="Good AC maintenance should help your system last longer and run more reliably. I do not treat it as an excuse for a contract pitch or a stream of upsells."
    imageSrc="/images/service-van.jpg"
    imageAlt="Wesley Chapel A/C Company service van"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/contact/", label: "Contact Info" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/maintenance/", label: "AC Maintenance" },
    ]}
    highlights={[
      "I keep maintenance practical",
      "No contract pressure",
      "Straightforward maintenance visits",
    ]}
  />

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Homeowner basics"
          title="A lot of useful maintenance starts with simple habits"
          intro="In Florida's heat and humidity, I tell homeowners that regular filter changes matter more than most people realize."
        />

        <ul class="text-list">
          <li>Change filters regularly.</li>
          <li>Keep the outdoor unit clear of overgrowth and debris.</li>
          <li>Pay attention when the system sounds different or airflow drops off.</li>
        </ul>
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="When professional maintenance helps"
          title="Useful maintenance should still be real service"
          intro="There are times when it makes sense for me to inspect, clean, and check the system. The key is making sure the visit is useful and clearly scoped."
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="No contract pressure"
          title="Maintenance should remain straightforward"
          intro="I do not build maintenance around gimmicks or constant pressure to buy add-ons. My goal is to help you care for the system responsibly and step in when real service is needed."
        />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="What a practical visit includes"
          title="What should actually happen"
        />
        <ul class="text-list">
          {maintenanceChecklist.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading eyebrow="Maintenance FAQ" title="Short answers to common concerns" />
        <FaqList items={maintenanceFaqs} />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="Related services"
          title="If maintenance turns into repair or replacement"
          intro="If routine upkeep turns into a repair issue or a bigger decision, these pages show how I handle that."
        />
        <div class="cards-grid">
          {serviceCards
            .filter((service) => service.href !== "/maintenance/")
            .map((service) => <ServiceCard {...service} />)}
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    title="If you want straightforward AC maintenance in Wesley Chapel, call me."
    body="Call if the system is due for real attention or if you want practical maintenance guidance."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
