---
import BaseLayout from "../layouts/BaseLayout.astro";
import CallToAction from "../components/CallToAction.astro";
import PageHero from "../components/PageHero.astro";
import ReviewCard from "../components/ReviewCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import {
  business,
  createBreadcrumbSchema,
  createWebPageSchema,
  reviewHighlights,
  toHref,
} from "../data/site";

const title = "About Wesley Chapel A/C Company | Local Family-Owned HVAC Company";
const description =
  "Meet Mike Reaka and learn why Wesley Chapel A/C Company serves local homeowners with clear advice, licensed workmanship, and neighborly service.";

const schema = [
  createWebPageSchema({
    pathname: "/about-us/",
    title,
    description,
  }),
  createBreadcrumbSchema([
    { name: "Home", pathname: "/" },
    { name: "About", pathname: "/about-us/" },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  pathname="/about-us/"
  image="/images/mike-portrait.jpg"
  schema={schema}
>
  <PageHero
    eyebrow="Local and family-owned"
    title="About Wesley Chapel A/C Company"
    summary="Wesley Chapel A/C Company is a family-owned residential A/C company serving homeowners in Wesley Chapel. This page gives some background on the company and owner."
    imageSrc="/images/mike-portrait.jpg"
    imageAlt="Mike Reaka standing beside the company van"
    actionPrimary={{ href: business.phoneHref, label: "Call Now" }}
    actionSecondary={{ href: "/reviews/", label: "Read Reviews" }}
    breadcrumbs={[
      { href: "/", label: "Home" },
      { href: "/about-us/", label: "About" },
    ]}
    highlights={[
      "Wesley Chapel roots",
      "Family-owned",
      `Licensed Florida contractor ${business.license}`,
    ]}
  />

  <section class="section">
    <div class="container split-grid">
      <div class="surface-card">
        <SectionHeading
          eyebrow="Meet Mike Reaka"
          title="A company shaped by local accountability"
          intro="Mike Reaka and his family have longstanding roots in Wesley Chapel. Wesley Chapel A/C Company was built around the idea that local homeowners deserve clear advice, careful work, and a company that keeps things practical when the heat is not giving them any extra patience."
        />
      </div>

      <div class="surface-card">
        <SectionHeading
          eyebrow="What the company believes"
          title="How the company approaches the work"
        />
        <ul class="text-list">
          <li>Be clear about the problem.</li>
          <li>Fix what can be fixed.</li>
          <li>Recommend replacement only when it is practical.</li>
          <li>Treat customers like neighbors, not transactions.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-up">
      <article class="surface-card">
        <SectionHeading
          eyebrow="Grounded values"
          title="Faith-informed, but still plainspoken"
          intro="The company's approach is shaped by convictions about stewardship and accountability. That shows up less in slogans and more in how recommendations are made and how customers are treated."
        />
        <p class="verse-note">
          <span>"The Borrower Becomes The Slave To The Lender."</span>
          <strong>Proverbs 22:7</strong>
        </p>
      </article>

      <article class="surface-card">
        <SectionHeading
          eyebrow="Licensed and visible"
          title="Licensing should be easy to find"
          intro="Wesley Chapel A/C Company is a licensed Florida contractor. Homeowners deserve to know who they are inviting to work on their system."
        />
        <ul class="pill-list">
          <li>License {business.license}</li>
          <li>Serving Wesley Chapel</li>
          <li>Family-owned</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <figure class="media-figure">
        <div class="media-card">
          <img
            src={toHref("/images/mike-go-kart.jpg")}
            alt="An older candid photo of Mike riding a go-kart"
            loading="lazy"
          />
        </div>
        <figcaption class="media-caption">
          An older candid photo kept here as part of the company story.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Customer comments"
        title="What local homeowners say after the work is done"
      />

      <div class="review-grid">
        {reviewHighlights.map((review) => (
          <ReviewCard {...review} />
        ))}
      </div>
    </div>
  </section>

  <CallToAction
    title="For service or scheduling, call Wesley Chapel A/C Company."
    body="The company serves Wesley Chapel homeowners and keeps phone as the main contact method."
    primaryHref={business.phoneHref}
    primaryLabel="Call Now"
    secondaryHref="/contact/"
    secondaryLabel="Contact Info"
  />
</BaseLayout>
