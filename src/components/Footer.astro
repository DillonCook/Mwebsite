---
import { business, navLinks, toHref } from "../data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href={toHref("/")} aria-label={business.shortName}>
        <img
          class="footer-brand__logo"
          src={toHref(business.logo)}
          alt=""
          width="1600"
          height="546"
          loading="lazy"
        />
      </a>
      <h2>Wesley Chapel homeowner listing and service details.</h2>
      <p class="footer-copy">
        Family-owned, licensed, and focused on straightforward information for
        Wesley Chapel homeowners.
      </p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul class="footer-links">
        {navLinks.map((link) => (
          <li>
            <a href={toHref(link.href)}>{link.label}</a>
          </li>
        ))}
        <li>
          <a href={toHref("/privacy/")}>Privacy</a>
        </li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <p>
        <a href={business.phoneHref}>{business.phone}</a>
      </p>
      <p>{business.hoursSummary}</p>
      <p>Licensed Florida contractor {business.license}</p>
      <p>Serving {business.serviceArea} homeowners only.</p>
      <p class="footer-note">No public storefront address is listed on this site.</p>
    </div>
  </div>

  <div class="container socket">
    <p>&copy; {new Date().getFullYear()} {business.shortName}. All rights reserved.</p>
  </div>

  <div class="mobile-callbar">
    <a class="button button-primary" href={business.phoneHref}>Call Now</a>
    <a class="button button-secondary" href={toHref("/contact/")}>Contact Info</a>
  </div>
</footer>
